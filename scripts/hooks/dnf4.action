#
# dnf4 post-transaction-actions plugin (python3-dnf-plugin-post-transaction-actions,
# RHEL/Alma/Rocky): rebuild KDE Infinite Desktop after KWin updates. Installed as
# /etc/dnf/plugins/post-transaction-actions.d/kde-infinite-desktop.action
# Log: /var/log/kde-infinite-desktop-rebuild.log
kwin*:in:/usr/lib/kde-infinite-desktop/kwin-update-hook.sh dnf
