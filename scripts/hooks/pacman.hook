#
# Rebuild KDE Infinite Desktop after KWin updates (KWin only loads plugins
# built for its exact version). Installed by scripts/install.sh to
# /etc/pacman.d/hooks/ and by the AUR package to /usr/share/libalpm/hooks/.
# The hook never fails the transaction; log: /var/log/kde-infinite-desktop-rebuild.log

[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = kwin

[Action]
Description = Rebuilding KDE Infinite Desktop for the new KWin version...
When = PostTransaction
Exec = /usr/lib/kde-infinite-desktop/kwin-update-hook.sh pacman
