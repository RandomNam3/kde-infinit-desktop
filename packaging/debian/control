Package: kde-infinit-desktop
Architecture: all
Build-Profiles: <!pkg.kde-infinit-desktop.noeffect !pkg.kde-infinit-desktop.noapp>
Depends: kwin-effect-infinitdesktop (>= ${source:Version}),
         kde-infinit-desktop-settings (>= ${source:Version}),
         ${misc:Depends},
Description: infinite canvas for KDE Plasma (metapackage)
 KDE Infinit Desktop turns every monitor into an infinite canvas: windows
 are placed on a plane that can be panned and zoomed freely with the mouse,
 the touchpad, a touchscreen or the keyboard.
 .
 This metapackage installs the KWin effect and the settings app.

Package: kwin-effect-infinitdesktop
Architecture: linux-any
Build-Profiles: <!pkg.kde-infinit-desktop.noeffect>
Depends: kde-infinit-desktop-data (= ${source:Version}),
         kwin-wayland (>= ${kwin:Version}),
         kwin-wayland (<< ${kwin:NextVersion}),
         ${misc:Depends},
         ${shlibs:Depends},
Recommends: kde-infinit-desktop-settings,
Description: infinite pannable and zoomable canvas - KWin effect
 KDE Infinit Desktop turns every monitor into an infinite canvas: windows
 are placed on a plane that can be panned and zoomed freely with the mouse,
 the touchpad, a touchscreen or the keyboard.
 .
 This package contains the KWin effect (Plasma 6, Wayland) and its System
 Settings module. KWin only loads plugins built for exactly its version, so
 this package depends on the KWin version it was built against and has to
 be rebuilt for every KWin update.

Package: kde-infinit-desktop-settings
Architecture: linux-any
Build-Profiles: <!pkg.kde-infinit-desktop.noapp>
Depends: kde-infinit-desktop-data (= ${source:Version}),
         qml6-module-qtquick,
         qml6-module-qtquick-controls,
         qml6-module-qtquick-layouts,
         qml6-module-qtquick-effects,
         qml6-module-qtquick-shapes,
         qml6-module-qtquick-window,
         qml6-module-qtqml-workerscript,
         qt6-svg-plugins | libqt6svg6,
         ${misc:Depends},
         ${shlibs:Depends},
Recommends: kwin-effect-infinitdesktop,
Description: infinite pannable and zoomable canvas - settings app
 KDE Infinit Desktop turns every monitor into an infinite canvas: windows
 are placed on a plane that can be panned and zoomed freely with the mouse,
 the touchpad, a touchscreen or the keyboard.
 .
 This package contains the standalone settings app
 kde-infinit-desktop-settings.

Package: kde-infinit-desktop-data
Architecture: all
Multi-Arch: foreign
Depends: ${misc:Depends},
Description: infinite pannable and zoomable canvas - shared data
 KDE Infinit Desktop turns every monitor into an infinite canvas: windows
 are placed on a plane that can be panned and zoomed freely with the mouse,
 the touchpad, a touchscreen or the keyboard.
 .
 This package contains the settings schema, the D-Bus interface description
 and the translations shared by the effect and the settings app.
